rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Comparación del correo de admin ignorando mayúsculas usando request.auth.token.email
    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == 'chat.gpt.sandoval@gmail.com';
    }

    function isValidProject(data) {
      return data.keys().hasAll([
          'title',
          'clientName',
          'videoUrl',
          'price',
          'currency',
          'showPrice',
          'watermarkEnabled',
          'watermarkText',
          'status',
          'whatsappNumber',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'title',
          'clientName',
          'videoUrl',
          'price',
          'currency',
          'showPrice',
          'watermarkEnabled',
          'watermarkText',
          'status',
          'whatsappNumber',
          'descargaHabilitada',
          'createdAt',
          'updatedAt'
        ]) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 100 &&
        data.videoUrl is string && data.videoUrl.size() >= 1 && data.videoUrl.size() <= 500 &&
        (data.price is int || data.price is float) && data.price >= 0 && data.price <= 100000000 &&
        data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 5 &&
        data.currency in ['S/', '$'] &&
        data.showPrice is bool &&
        data.watermarkEnabled is bool &&
        data.watermarkText is string && data.watermarkText.size() >= 0 && data.watermarkText.size() <= 100 &&
        data.status is string && data.status.size() >= 1 && data.status.size() <= 40 &&
        data.status in ['En revisión', 'Cambios solicitados', 'Aprobado'] &&
        data.whatsappNumber is string && data.whatsappNumber.size() >= 0 && data.whatsappNumber.size() <= 30 &&
        (!('descargaHabilitada' in data) || data.descargaHabilitada is bool) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidEntrega(data) {
      return data.keys().hasAll([
          'finalVideoUrl',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'finalVideoUrl',
          'updatedAt'
        ]) &&
        data.finalVideoUrl is string && data.finalVideoUrl.size() >= 0 && data.finalVideoUrl.size() <= 500 &&
        data.updatedAt is timestamp;
    }

    function isValidComment(data) {
      return data.keys().hasAll([
          'projectId',
          'authorName',
          'text',
          'videoSecond',
          'createdAt',
          'resolved'
        ]) &&
        data.keys().hasOnly([
          'projectId',
          'authorName',
          'text',
          'videoSecond',
          'createdAt',
          'resolved'
        ]) &&
        isValidId(data.projectId) &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 1000 &&
        (data.videoSecond is int || data.videoSecond is float) && data.videoSecond >= 0 && data.videoSecond <= 86400 &&
        data.createdAt is timestamp &&
        data.resolved is bool;
    }

    // Colección projects (solo contiene el video de vista previa)
    match /projects/{projectId} {
      // Cualquiera puede LEER un proyecto solo si conoce su ID exacto
      allow get: if isValidId(projectId);

      // Nadie excepto el admin puede listar todos los proyectos
      allow list: if isAdmin();

      // Solo el admin puede crear proyectos
      allow create: if isAdmin() &&
        isValidId(projectId) &&
        projectId.size() >= 20 &&
        isValidProject(incoming());

      // Admin puede editar todo; el cliente solo puede cambiar el campo 'status'
      // entre los 3 valores válidos y ÚNICAMENTE mientras descargaHabilitada sea false.
      allow update: if isValidId(projectId) &&
        isValidProject(incoming()) && (
          isAdmin() ||
          (
            (!('descargaHabilitada' in existing()) || existing().descargaHabilitada == false) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
            incoming().status in ['En revisión', 'Cambios solicitados', 'Aprobado']
          )
        );

      // Solo el admin puede borrar proyectos
      allow delete: if isAdmin() && isValidId(projectId);
    }

    // Colección entregas (contiene finalVideoUrl sin marca de agua)
    match /entregas/{projectId} {
      // Cualquiera puede leer entregas/ID SOLO si el proyecto projects/ID tiene descargaHabilitada == true (o si es el admin)
      allow get: if isValidId(projectId) && (
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/projects/$(projectId)) &&
          get(/databases/$(database)/documents/projects/$(projectId)).data.descargaHabilitada == true
        )
      );

      allow list: if isAdmin();

      // Solo el admin puede crear, editar o borrar en entregas
      allow create: if isAdmin() && isValidId(projectId) && isValidEntrega(incoming());
      allow update: if isAdmin() && isValidId(projectId) && isValidEntrega(incoming());
      allow delete: if isAdmin() && isValidId(projectId);
    }

    // Colección comments
    match /comments/{commentId} {
      allow get: if isValidId(commentId);
      allow list: if true;

      allow create: if isValidId(commentId) &&
        isValidComment(incoming()) &&
        incoming().resolved == false &&
        exists(/databases/$(database)/documents/projects/$(incoming().projectId));

      allow update: if isAdmin() &&
        isValidId(commentId) &&
        isValidComment(incoming());

      allow delete: if isAdmin() && isValidId(commentId);
    }
  }
}
